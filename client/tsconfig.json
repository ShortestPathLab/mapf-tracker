{
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {"*": ["./src/*", "../server/src/*"]},
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["node_modules"]
}
